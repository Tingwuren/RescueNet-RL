[Unit]
Description=RescueNet Frontend (Vite Dev Server)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/Projects/RescueNet-RL/frontend
ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0 --port 5173
Restart=always
RestartSec=3
User=root
Environment=NODE_ENV=development

[Install]
WantedBy=multi-user.target
